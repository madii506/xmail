{
  "cleanUrls": true,
  "functions": { "api/xmail.js": { "maxDuration": 20 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/xmail?__p=:path*" }
  ],
  "headers": [
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Frame-Options", "value": "DENY" }] }
  ]
}
